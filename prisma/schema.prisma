generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum WordStatus {
  UNKNOWN
  LEARNING
  LEARNED
}

model Word {
  id        Int        @id @default(autoincrement())
  word      String
  meaning   String
  example   String?
  status    WordStatus @default(UNKNOWN)
  createdAt DateTime   @default(now())
  categories Category[]
}

model Category {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  words     Word[]
  createdAt DateTime  @default(now())
}
